# Copy to .env.local (git-ignored) and fill in. Never commit .env.local.

# Sanity project (public — used in the browser by the embedded Studio and image URLs)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Write token used by POST /api/submit to store form entries. Never exposed to the browser.
SANITY_API_WRITE_TOKEN=

# Server-only. Shared secret the Sanity webhook sends to POST /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Google Tag Manager container id (GTM-XXXXXXX). Loaded via @next/third-parties.
NEXT_PUBLIC_GTM_ID=

# Absolute site URL, no trailing slash. Used for canonical, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
